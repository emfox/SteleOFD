# SteleOFD 简体中文 · 命令行输出

cli-pages = 页数：{ $count }
cli-page-size = 页面尺寸：{ $w } x { $h } 毫米
cli-version = 版本：{ $version }
cli-embedded-fonts = 内嵌字体：{ $count }
cli-signatures = 签名：{ $count }
cli-no-pages = 该文档未声明任何页面
cli-wrote = 已写入 { $path }
cli-rendered-page = 已渲染第 { $page } 页，{ $dpi } dpi
cli-converted = 已将 { $count } 页转换为 { $format }
