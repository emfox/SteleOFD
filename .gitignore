# ─── Rust / Cargo ───
/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata

# Legacy temp directory name kept for compatibility
/artifacts/

# ─── Build output ───
build/
dist/
*.dll
*.dylib
*.so
*.a
*.lib
*.exe

# WASM artifacts produced by wasm-pack
pkg/
wasm-pack.log
*.wasm

# C headers generated by cbindgen at build time
include/steleofd.h

# ─── Test and benchmark output ───
/criterion/
*.svg
!docs/**/*.svg

# ─── Generated documentation ───
/docs/book/
/doc/

# ─── Python ───
__pycache__/
*.py[cod]

# ─── IDE / editor ───
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.project
.classpath

# ─── Operating system ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Logs and local data ───
*.log
logs/
/tmp/

# ─── Local test data: large, never committed ───
/tests/fixtures/large/
/tests/fixtures/private/
# Third-party samples fetched by scripts/fetch_ofdrw.py and
# scripts/fetch_gb_samples.py. They are not ours to redistribute and they are
# large, so they stay out of the tree; the pinned list in each script is what a
# fresh checkout has.
*.ofd
# Fetched samples stay out even though fixtures generally do not: the rule
# below would otherwise re-include them.
/tests/fixtures/ofdrw/
/tests/fixtures/gb-t-33190/
!tests/fixtures/**/*.ofd
!docs/**/*.ofd
!compliance/fixtures/**/*.ofd

# ─── Secrets: must never be committed ───
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
credentials.toml

# ─── Local workspace config overrides ───
.cargo/config.toml
!.cargo/config.toml.example

# ─── Coverage reports ───
/coverage/
*.profraw
lcov.info
tarpaulin-report.html
